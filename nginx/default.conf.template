worker_processes auto;

events {
    worker_connections 1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    sendfile        on;
    keepalive_timeout 65;
    server_tokens   off;

    # Logging (stdout so `docker logs` works)
    access_log /dev/stdout;
    error_log  /dev/stderr warn;

    # Upstreams — resolved once at start
    upstream front_upstream {
        server front:80;
    }

    upstream api_upstream {
        server api:${API_INTERNAL_PORT};
    }

    # ----- Main site: modulacase.ru -----
    server {
        listen 80;
        server_name ${SITE_DOMAIN};

        client_max_body_size 20m;

        # API under /api/ — keep the prefix, DO NOT add trailing slash on proxy_pass
        location /api/ {
            proxy_pass http://api_upstream;
            proxy_http_version 1.1;
            proxy_set_header Host              $host;
            proxy_set_header X-Real-IP         $remote_addr;
            proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Host  $host;
            proxy_set_header Connection        "";
        }

        # Frontend
        location / {
            proxy_pass http://front_upstream;
            proxy_http_version 1.1;
            proxy_set_header Host              $host;
            proxy_set_header X-Real-IP         $remote_addr;
            proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Upgrade           $http_upgrade;
            proxy_set_header Connection        "upgrade";
        }
    }

    # ----- API host: api.modulacase.ru -----
    server {
        listen 80;
        server_name ${API_DOMAIN};

        client_max_body_size 20m;

        location / {
            proxy_pass http://api_upstream;
            proxy_http_version 1.1;
            proxy_set_header Host              $host;
            proxy_set_header X-Real-IP         $remote_addr;
            proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Host  $host;
            proxy_set_header Connection        "";
        }
    }
}
