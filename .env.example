# ─── Target domain (RU server) ───────────────────────────────────────────
SITE_DOMAIN=modula.by
API_DOMAIN=api.modula.by

# ─── Source directories (relative to ~/envbox) ───────────────────────────
API_DIR=../api.modula.by
FRONT_DIR=../modula.by

# ─── Host port mappings ("07 in the middle") ─────────────────────────────
NGINX_PORT=3076
API_PORT=3077
DB_PORT=3078

# In-container API port — must match PORT in ../api.modulacase.ru/.env
API_INTERNAL_PORT=3070

# ─── MySQL ───────────────────────────────────────────────────────────────
# Read by the mysql:8 image to bootstrap the DB, and by the api service
# via DB_PASS=${MYSQL_PASSWORD}. Single source of truth: MYSQL_PASSWORD.
MYSQL_ROOT_PASSWORD=r0otPwd
MYSQL_USER=user
MYSQL_PASSWORD=us3rPp@ss
MYSQL_DATABASE=modula
